{
  "name": "netmap",
  "productName": "NetMap",
  "version": "0.49.0",
  "description": "Interactive network map & inventory for sysadmins (Hotel Usadba prototype)",
  "author": {
    "name": "NetMap",
    "email": "netmap@localhost"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "start": "vite build && electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && node scripts/strip-cpu-features.cjs && electron-builder",
    "build:win": "vite build && node scripts/strip-cpu-features.cjs && electron-builder --win",
    "build:win:portable": "vite build && node scripts/strip-cpu-features.cjs && electron-builder --win portable",
    "build:win:dir": "vite build && node scripts/strip-cpu-features.cjs && electron-builder --win --dir",
    "publish:win": "vite build && node scripts/strip-cpu-features.cjs && electron-builder --win --publish always",
    "rebuild-native": "electron-builder install-app-deps",
    "postinstall": "node scripts/strip-cpu-features.cjs"
  },
  "build": {
    "appId": "ai.arena.netmap",
    "productName": "NetMap",
    "copyright": "Copyright © 2026 NetMap",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/cpu-features/**",
      "!node_modules/**/node_modules/cpu-features/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/ssh2/**",
      "node_modules/argon2-browser/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "differentialPackage": false,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NetMap"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "m0xvi",
        "repo": "netmap",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.3.5",
    "argon2-browser": "^1.18.0",
    "better-sqlite3": "^11.3.0",
    "dagre": "^0.8.5",
    "electron-updater": "^6.8.9",
    "html-to-image": "^1.11.13",
    "https-proxy-agent": "^9.1.0",
    "kdbxweb": "^2.1.1",
    "net-snmp": "^3.26.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socks-proxy-agent": "^10.1.0",
    "ssh2": "^1.17.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  }
}
