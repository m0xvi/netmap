# NetMap .gitignore
#
# Keep the repo lean — source only. CI/Actions rebuild everything from
# package.json + package-lock.json.

# Dependencies
node_modules/

# Build outputs
dist/
release/
out/
.vite/

# Auto-generated icons (regenerated by build scripts)
# NOTE: keep this section commented out if you want icons in the repo.
# build/icon.png
# build/icon.ico

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets — never commit
.env
.env.local
.env.*.local
*.pem

# Runtime / test artifacts
coverage/
*.tsbuildinfo
